# --- RAYCAST ---
raycast/.config/raycast/extensions/
raycast/.config/raycast/ai/

# --- APP STATE ---
nchat/.config/nchat/emojis/

# --- BINARY IMAGES ---
# Never commit app-generated PNGs/preview images - they bloat git history permanently.
# Git can't delta-compress binary blobs, so each one adds its full size with no dedup.
*.png
*.jpg
*.jpeg
*.gif

# --- NVIM RUNTIME DUMPS ---
checkhealth_*.txt

# --- GIT ---
git/.gitconfig

# --- THEME STATE ---
# Runtime state written by scripts/switch-theme, not config.
# Source of truth is shell/shared/themes/registry.tsv + default-theme.
kitty/.config/kitty/themes/current-theme.conf
shell/shared/active-theme.zsh
shell/shared/active-theme.nu
ghostty/.config/ghostty/active-theme.conf
nvim/.config/nvim/lua/active-theme.lua
alacritty/.config/alacritty/active-theme.toml
yazi/.config/yazi/theme.toml
tmux/.config/tmux/themes/current-theme.conf

