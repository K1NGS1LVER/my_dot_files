[manager]
show_hidden = true
show_symlink = true

[opener]
book = [
    { run = 'open -a Books "$@"', block = true, desc = "Apple Books" }
]

[open]
rules = [
    { name = "*.epub", use = "book" }
]

[status]
separator_open  = ""
separator_close = ""
show_right = ["permissions", "percentage", "position", "timestamp", "size"]
