{
  "theme": "Rosé Pine",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "buffer_font_family": "JetBrains Mono",
  "terminal": {
    "font_size": 15,
    "font_family": "JetBrains Mono",
    "copy_on_select": true,
    "dock": "bottom",
  },
  "tab_size": 2,
  "relative_line_numbers": true,
  "cursor_shape": "block",
  "cursor_blink": false,
  "scrollbar": {
    "show": "never",
  },
  "vertical_scroll_margin": 8,
  "autosave": "off",
  "format_on_save": "on",
  "show_whitespaces": "selection",
  "show_inline_completions": true,
  "inlay_hints": {
    "enabled": true,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 240,
  },
  "soft_wrap": "editor_width",
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path_lookup": true,
      },
    },
    "pyright": {
      "settings": {
        "python": {
          "analysis": {
            "typeCheckingMode": "off",
          },
        },
      },
    },
    "gopls": {
      "settings": {
        "local": "go",
        "gofumpt": true,
      },
    },
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-", "--stdin-filename", "{buffer_path}"],
        },
      },
    },
    "Java": {
      "tab_size": 4,
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Go": {
      "formatter": {
        "external": {
          "command": "goimports",
        },
      },
    },
    "Rust": {
      "formatter": {
        "external": {
          "command": "rustfmt",
        },
      },
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["-"],
        },
      },
    },
  },
}
