# None — plain terminal, no theme/accent colors
# Deliberately minimal: no FZF_DEFAULT_OPTS or ZSH_HIGHLIGHT_STYLES overrides,
# so fzf and zsh-syntax-highlighting fall back to their own tool defaults
# instead of inheriting a themed palette. This is intentional, not unfinished.
# Identical (lack of) palette to none.nu — do not add one without the other.

export BAT_THEME="ansi"
