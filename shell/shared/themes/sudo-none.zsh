# Sudo-none — none's minimal shell palette (text-only accents), retained so
# fzf/zsh-syntax-highlighting keep their own tool defaults exactly as in none.
# Contrast over light wallpapers is handled by the terminal bg (sudo-none.conf),
# not here. Identical (lack of) palette to none.zsh — do not diverge from it.

export BAT_THEME="ansi"
