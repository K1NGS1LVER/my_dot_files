#!/usr/bin/env bash
# deploy: create/repair every symlink in scripts/lib/manifest.sh.
# Idempotent. Anything replaced is moved to ~/.dotfiles-backup/<timestamp>/ first.
# Usage: deploy [--dry-run]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/manifest.sh"

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

BACKUP_ROOT="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
changed=0
skipped=0

backup() {
  local target="$1"
  local rel="${target#"$HOME"/}"
  local dest="$BACKUP_ROOT/$rel"
  if (( DRY_RUN )); then
    echo "  would back up: $target -> $dest"
  else
    mkdir -p "$(dirname "$dest")"
    mv "$target" "$dest"
    echo "  backed up: $target -> $dest"
  fi
}

link() {
  local src="$1" target="$2"
  if (( DRY_RUN )); then
    echo "  would link: $target -> $src"
  else
    mkdir -p "$(dirname "$target")"
    ln -sfn "$src" "$target"
    echo "  linked: $target -> $src"
  fi
}

for entry in "${LINKS[@]}"; do
  src="$DOTFILES_DIR/${entry%%|*}"
  target="$HOME/${entry##*|}"

  if [[ ! -e "$src" ]]; then
    echo "ERROR: manifest source missing: $src" >&2
    exit 1
  fi

  if [[ -L "$target" && "$(readlink "$target")" == "$src" ]]; then
    ((skipped += 1))
    continue
  fi

  echo "fixing: $target"
  # -e follows symlinks, so also test -L to catch broken/relative links
  if [[ -e "$target" || -L "$target" ]]; then
    backup "$target"
  fi
  link "$src" "$target"
  ((changed += 1))
done

for rel in "${OBSOLETE_LINKS[@]}"; do
  target="$HOME/$rel"
  if [[ -L "$target" ]]; then
    echo "removing obsolete link: $target"
    backup "$target"
    ((changed += 1))
  fi
done

# Materialize theme state files if any are missing (no-op when all present)
if [[ -x "$SCRIPT_DIR/switch-theme" ]] && "$SCRIPT_DIR/switch-theme" --help 2>/dev/null | grep -q -- --ensure; then
  if (( DRY_RUN )); then
    echo "would run: switch-theme --ensure"
  else
    "$SCRIPT_DIR/switch-theme" --ensure
  fi
fi

echo
if (( DRY_RUN )); then
  echo "deploy --dry-run: $changed pending action(s), $skipped already correct"
else
  echo "deploy: $changed change(s), $skipped already correct"
  (( changed > 0 )) && echo "backups (if any): $BACKUP_ROOT"
fi
