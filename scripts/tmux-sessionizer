#!/usr/bin/env bash
# tmux-sessionizer — fuzzy-find a project directory and create/attach a tmux
# session named after it. Modeled on ThePrimeagen's tmux-sessionizer.sh.
#
# Search roots:
#   ~/dotfiles   offered directly (single project, not a container)
#   ~/projects   container -> subdirectories up to 2 levels deep
#
# Usage:
#   tmux-sessionizer            fzf picker over the roots above
#   tmux-sessionizer <path>     skip the picker, use <path> directly
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES="$(cd "$SCRIPT_DIR/.." && pwd)"

SEARCH_PATHS=(
  "$HOME/projects"
)

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  selected=$(
    {
      echo "$DOTFILES"
      fd . "${SEARCH_PATHS[@]}" --min-depth 1 --max-depth 2 --type d 2>/dev/null
    } | fzf --header 'tmux session for:' --height 40% --reverse
  )
fi

[[ -z "${selected:-}" ]] && exit 0
[[ -d "$selected" ]] || exit 0

# tmux session names can't contain '.' (window/pane separator) or ':'
# (session:window target separator); strip spaces too for easy manual `-t` typing.
selected_name=$(basename "$selected" | tr ' .:' '___')

tmux_running=$(pgrep -x tmux || true)

if [[ -z "${TMUX:-}" && -z "$tmux_running" ]]; then
  exec tmux new-session -s "$selected_name" -c "$selected"
fi

if ! tmux has-session -t "=$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "=$selected_name"
else
  tmux attach-session -t "=$selected_name"
fi
