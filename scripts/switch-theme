#!/usr/bin/env bash
# switch-theme — theme switcher for Kitty, Ghostty, Zsh, Nushell, and Neovim.
#
# Theme identity lives in one place: shell/shared/themes/registry.tsv.
# The 5 per-app "active theme" artifacts are runtime STATE, not config:
# they are gitignored, and are materialized from shell/shared/themes/default-theme
# (or ~/.local/state/dotfiles/current-theme, if it already exists) by --ensure.
#
# Usage:
#   switch-theme [theme_name]   switch to theme_name (fzf picker if omitted)
#   switch-theme --ensure       materialize state files if missing; no-op otherwise
#   switch-theme --list         list available theme names
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES="$(cd "$SCRIPT_DIR/.." && pwd)"

REGISTRY="$DOTFILES/shell/shared/themes/registry.tsv"
DEFAULT_THEME_FILE="$DOTFILES/shell/shared/themes/default-theme"
STATE_DIR="$HOME/.local/state/dotfiles"
STATE_FILE="$STATE_DIR/current-theme"

KITTY_THEME_DIR="$DOTFILES/kitty/.config/kitty/themes"
KITTY_CURRENT="$KITTY_THEME_DIR/current-theme.conf"
SHELL_THEME_DIR="$DOTFILES/shell/shared"
ZSH_ACTIVE="$SHELL_THEME_DIR/active-theme.zsh"
NU_ACTIVE="$SHELL_THEME_DIR/active-theme.nu"
GHOSTTY_ACTIVE="$DOTFILES/ghostty/.config/ghostty/active-theme.conf"
ALACRITTY_THEME_DIR="$DOTFILES/alacritty/.config/alacritty/themes"
ALACRITTY_ACTIVE="$DOTFILES/alacritty/.config/alacritty/active-theme.toml"
NVIM_ACTIVE="$DOTFILES/nvim/.config/nvim/lua/active-theme.lua"

# --- registry helpers -------------------------------------------------------

theme_names() {
    tail -n +2 "$REGISTRY" | cut -f1
}

registry_row() {
    # $1 = theme name; prints ghostty_display_name<TAB>nvchad_base46_name, or nothing
    awk -F'\t' -v t="$1" 'NR>1 && $1==t {print $2"\t"$3; found=1} END {exit !found}' "$REGISTRY"
}

usage() {
    echo "Usage: switch-theme [theme_name|--ensure|--list]"
    echo "Available themes:"
    theme_names | sed 's/^/  - /'
    exit 1
}

# --- per-app asset existence check -----------------------------------------

assets_exist() {
    local t="$1"
    [[ -f "$KITTY_THEME_DIR/$t.conf" ]] || { echo "missing kitty theme: $KITTY_THEME_DIR/$t.conf" >&2; return 1; }
    [[ -f "$SHELL_THEME_DIR/themes/$t.zsh" ]] || { echo "missing zsh theme: $SHELL_THEME_DIR/themes/$t.zsh" >&2; return 1; }
    [[ -f "$SHELL_THEME_DIR/themes/$t.nu" ]] || { echo "missing nu theme: $SHELL_THEME_DIR/themes/$t.nu" >&2; return 1; }
    [[ -f "$ALACRITTY_THEME_DIR/$t.toml" ]] || { echo "missing alacritty theme: $ALACRITTY_THEME_DIR/$t.toml" >&2; return 1; }
}

# --- atomic write helper -----------------------------------------------------

write_atomic() {
    # $1 = target path, $2 = content
    local target="$1" content="$2"
    local tmp
    tmp="$(mktemp "${target}.XXXXXX")"
    printf '%s\n' "$content" > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$target"
}

# --- apply a theme (all writes; assumes validation already passed) ---------

apply_theme() {
    local t="$1"
    local row ghostty_name base46_name
    row="$(registry_row "$t")"
    ghostty_name="$(cut -f1 <<<"$row")"
    base46_name="$(cut -f2 <<<"$row")"

    mkdir -p "$KITTY_THEME_DIR" "$(dirname "$GHOSTTY_ACTIVE")" "$(dirname "$ALACRITTY_ACTIVE")" "$(dirname "$NVIM_ACTIVE")" "$STATE_DIR"

    ln -sfn "$t.conf" "$KITTY_CURRENT"
    ln -sfn "themes/$t.zsh" "$ZSH_ACTIVE"
    ln -sfn "themes/$t.nu" "$NU_ACTIVE"
    write_atomic "$GHOSTTY_ACTIVE" "theme = $ghostty_name"
    cat "$ALACRITTY_THEME_DIR/$t.toml" > "$ALACRITTY_ACTIVE"
    write_atomic "$NVIM_ACTIVE" "return \"$t\""
    write_atomic "$STATE_FILE" "$t"
}

current_theme() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    elif [[ -f "$DEFAULT_THEME_FILE" ]]; then
        cat "$DEFAULT_THEME_FILE"
    else
        echo ""
    fi
}

reload_apps() {
    command -v killall &>/dev/null && killall -USR1 kitty 2>/dev/null || true
    # Ghostty reloads its configuration automatically.
}

# --- subcommands -------------------------------------------------------------

cmd_list() {
    theme_names
    exit 0
}

cmd_ensure() {
    local t
    t="$(current_theme)"
    if [[ -z "$t" ]]; then
        echo "No default theme configured (missing $DEFAULT_THEME_FILE)." >&2
        exit 1
    fi
    if [[ -L "$KITTY_CURRENT" && -L "$ZSH_ACTIVE" && -L "$NU_ACTIVE" && -f "$GHOSTTY_ACTIVE" && -f "$ALACRITTY_ACTIVE" && -f "$NVIM_ACTIVE" ]]; then
        exit 0
    fi
    if ! assets_exist "$t"; then
        echo "Error: theme '$t' is missing assets; cannot bootstrap." >&2
        exit 1
    fi
    apply_theme "$t"
    echo "Bootstrapped theme state: $t"
}

cmd_switch() {
    local theme="$1"

    if [[ -z "$theme" ]]; then
        if command -v fzf &>/dev/null; then
            theme=$(theme_names | fzf --prompt="Select theme  " --height=15 --layout=reverse --border \
                --preview="python3 $SCRIPT_DIR/preview-theme.py {}" --preview-window=right:55%)
            [[ -z "$theme" ]] && exit 1
        else
            echo "No theme specified and fzf is not installed."
            usage
        fi
    fi

    if [[ -z "$(registry_row "$theme")" ]]; then
        echo "Error: Unknown theme '$theme'."
        usage
    fi

    if ! assets_exist "$theme"; then
        echo "Error: theme '$theme' is missing one or more per-app assets. No changes made." >&2
        exit 1
    fi

    local previous
    previous="$(current_theme)"

    echo "Switching theme to: $theme..."
    if ! apply_theme "$theme"; then
        echo "Error applying theme '$theme'; attempting to restore previous theme '$previous'." >&2
        if [[ -n "$previous" ]] && assets_exist "$previous"; then
            apply_theme "$previous" || echo "Rollback also failed; state may be inconsistent." >&2
        fi
        exit 1
    fi

    reload_apps
    echo "Theme successfully changed to $theme!"
}

# --- entry point --------------------------------------------------------------

case "${1:-}" in
    --ensure) cmd_ensure ;;
    --list) cmd_list ;;
    --help|-h) usage ;;
    *) cmd_switch "${1:-}" ;;
esac
