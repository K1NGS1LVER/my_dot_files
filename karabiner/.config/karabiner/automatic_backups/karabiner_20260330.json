{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Apple Books & Pages Vim Mode Controller",
                        "manipulators": [
                            {
                                "type": "basic",
                                "description": "Enter Insert Mode (Enable typing)",
                                "from": { "key_code": "i" },
                                "to": [
                                    { "set_variable": { "name": "books_insert_mode", "value": 1 } },
                                    { "shell_command": "afplay /System/Library/Sounds/Tink.aiff" }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] },
                                    { "type": "variable_if", "name": "books_insert_mode", "value": 0 }
                                ]
                            },
                            {
                                "type": "basic",
                                "description": "Force Reset Mode (Opt+Esc)",
                                "from": { "key_code": "escape", "modifiers": { "mandatory": ["left_alt"] } },
                                "to": [
                                    { "set_variable": { "name": "books_insert_mode", "value": 0 } },
                                    { "shell_command": "afplay /System/Library/Sounds/Pop.aiff" }
                                ]
                            },
                            {
                                "type": "basic",
                                "description": "Exit Insert Mode (Physical Esc)",
                                "from": { "key_code": "escape" },
                                "to": [
                                    { "set_variable": { "name": "books_insert_mode", "value": 0 } },
                                    { "key_code": "escape" }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] }
                                ]
                            },
                             {
                                "type": "basic",
                                "description": "Exit Insert Mode (Caps Lock Tap)",
                                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                                "to": [
                                    { "key_code": "left_control" }
                                ],
                                "to_if_alone": [
                                     { "set_variable": { "name": "books_insert_mode", "value": 0 } },
                                     { "key_code": "escape" }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Vim Navigation (hjkl) - Only in Normal Mode",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "left_arrow" }],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] },
                                    { "type": "variable_if", "name": "books_insert_mode", "value": 0 }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "down_arrow" }],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] },
                                    { "type": "variable_if", "name": "books_insert_mode", "value": 0 }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "up_arrow" }],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] },
                                    { "type": "variable_if", "name": "books_insert_mode", "value": 0 }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "right_arrow" }],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.iBooksX$", "^com\\.apple\\.iWork\\.Pages$"] },
                                    { "type": "variable_if", "name": "books_insert_mode", "value": 0 }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Caps→Esc/Ctrl if held (Global Fallback)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}
