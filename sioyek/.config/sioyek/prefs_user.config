 # 1. Faster/Smoother Scrolling (Mac touchpad)
touchpad_sensitivity 2.0
smooth_scroll_speed 3
smooth_scroll_drag 2000

# 2. Bigger Jumps for j/k (default is 1.0)
vertical_move_amount 1.0

# 3. Bigger Jumps for Space/Screen Down (default is 0.5)
move_screen_ratio 0.8

# 4. Enable Smooth Scroll by Default (update your existing line)
startup_commands toggle_custom_color
toggle_smooth_scroll

   # Catppuccin Mocha colors
   custom_background_color      #1e1e2e
   custom_text_color            #cdd6f4

   # Highlight colors (for i, a, s commands)
   highlight_color_a            #f5e0dc
   highlight_color_b            #f2cdcd
   highlight_color_c            #f5c2e7
   highlight_color_d            #cba6f7
   highlight_color_e            #f38ba8
   highlight_color_f            #eba0ac
   highlight_color_g            #fab387

   # Search and UI highlights
   search_highlight_color       #f9e2af
   status_bar_color             #1e1e2e
   status_bar_text_color        #cdd6f4
   ui_text_color                #cdd6f4
   ui_background_color          #313244
